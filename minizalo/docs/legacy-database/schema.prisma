generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  STUDENT
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum VoucherScope {
  SERVICE
  COURSE
  ALL
}

enum DiscountType {
  FIXED
  PERCENT
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum TreatmentSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

model User {
  id        String    @id @default(cuid())
  zaloId    String?   @unique
  name      String
  phone     String?   @unique
  email     String?   @unique
  avatarUrl String?
  role      UserRole  @default(CUSTOMER)
  tier      String    @default("Silver")
  points    Int       @default(0)
  dob       String?
  gender    String?
  address   String?
  preferredBranch       String?
  skinType              String?
  healthNotes           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  enrollments CourseEnrollment[]
  notifications Notification[]
  vouchers UserVoucher[]
  treatmentPlans TreatmentPlan[]
  invoices       Invoice[]
  pointTransactions PointTransaction[]
}

model Voucher {
  id                   String       @id @default(cuid())
  code                 String       @unique
  title                String
  description          String
  scope                VoucherScope
  discountType         DiscountType
  discountValue        Int
  maxDiscountAmount    Int?
  minOrderValue        Int          @default(0)
  applicableCategories String[]
  startsAt             DateTime
  expiresAt            DateTime
  usageLimit           Int?
  usageCount           Int          @default(0)
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  users                UserVoucher[]
}

model UserVoucher {
  userId     String
  voucherId  String
  claimedAt  DateTime @default(now())
  usedAt     DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@id([userId, voucherId])
  @@index([userId, usedAt])
}

model Branch {
  id        String         @id @default(cuid())
  name      String
  address   String
  city      String
  phone     String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  services  BranchService[]
  staff     Specialist[]
  bookings  Booking[]
  treatmentPlans TreatmentPlan[]
}

model Service {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  category        String
  description     String?
  durationMinutes Int
  price           Decimal        @db.Decimal(12, 0)
  originalPrice   Decimal?       @db.Decimal(12, 0)
  rating          Decimal        @default(0) @db.Decimal(2, 1)
  reviewsCount    Int            @default(0)
  badge           String?
  imageUrl        String?
  indicatorsCount Int            @default(0)
  preparationNotes String[]
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  branches        BranchService[]
  specialists     SpecialistService[]
  bookings        Booking[]
  treatmentPlans  TreatmentPlan[]
}

model TreatmentPlan {
  id            String              @id @default(cuid())
  userId        String
  serviceId     String
  branchId      String
  name          String
  imageUrl      String?
  notes         String?
  totalSessions Int
  status        TreatmentPlanStatus @default(ACTIVE)
  purchasedAt   DateTime            @default(now())
  expiresAt     DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id])
  service       Service             @relation(fields: [serviceId], references: [id])
  branch        Branch              @relation(fields: [branchId], references: [id])
  sessions      TreatmentSession[]

  @@index([userId, status])
}

model Invoice {
  id            String        @id @default(cuid())
  code          String        @unique
  userId        String
  bookingId     String?       @unique
  enrollmentId  String?       @unique
  title         String
  description   String?
  amount        Decimal       @db.Decimal(12, 0)
  discount      Decimal       @default(0) @db.Decimal(12, 0)
  finalAmount   Decimal       @db.Decimal(12, 0)
  paymentMethod String
  status        InvoiceStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  description String
  points      Int
  entityType  String?
  entityId    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TreatmentSession {
  id           String                 @id @default(cuid())
  planId       String
  sessionNumber Int
  status       TreatmentSessionStatus @default(SCHEDULED)
  scheduledAt  DateTime?
  completedAt  DateTime?
  specialistName String?
  title        String
  notes        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  plan         TreatmentPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sessionNumber])
  @@index([planId, status])
}

model BranchService {
  branchId  String
  serviceId String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([branchId, serviceId])
}

model Specialist {
  id              String              @id @default(cuid())
  branchId        String
  name            String
  title           String
  specialty       String
  workplace       String?
  bio             String?
  avatarUrl       String?
  experienceYears Int                 @default(0)
  rating          Decimal             @default(0) @db.Decimal(2, 1)
  reviewsCount    Int                 @default(0)
  consultationFee Decimal             @default(0) @db.Decimal(12, 0)
  isActive        Boolean             @default(true)
  branch          Branch              @relation(fields: [branchId], references: [id])
  services        SpecialistService[]
  schedules       WorkSchedule[]
  bookings        Booking[]
}

model SpecialistService {
  specialistId String
  serviceId    String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([specialistId, serviceId])
}

model WorkSchedule {
  id           String     @id @default(cuid())
  specialistId String
  date         DateTime   @db.Date
  startTime    String
  endTime      String
  isAvailable  Boolean    @default(true)
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([specialistId, date])
}

model Booking {
  id           String        @id @default(cuid())
  code         String        @unique
  userId       String
  branchId     String
  serviceId    String
  specialistId String?
  scheduledAt  DateTime
  status       BookingStatus @default(PENDING)
  notes        String?
  totalAmount  Decimal       @db.Decimal(12, 0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  specialist   Specialist?   @relation(fields: [specialistId], references: [id])

  @@index([userId, scheduledAt])
  @@index([branchId, scheduledAt])
  @@index([specialistId, scheduledAt])
  @@unique([specialistId, scheduledAt])
}

model Course {
  id          String   @id
  title       String
  category    String
  price       Decimal  @db.Decimal(12, 0)
  deposit     Decimal  @db.Decimal(12, 0)
  duration    String
  instructor  String
  imageUrl    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  enrollments CourseEnrollment[]
}

model CourseEnrollment {
  id          String           @id @default(cuid())
  code        String           @unique
  userId      String
  courseId    String
  studentName String
  phone       String
  email       String?
  totalAmount Decimal          @db.Decimal(12, 0)
  status      EnrollmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id])
  course      Course           @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  entityId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

