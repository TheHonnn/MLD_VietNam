{
  "name": "mld-backend",
  "version": "1.0.0",
  "description": "MediLearn Healthcare & Vocational Academy REST API",
  "main": "dist/main.js",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:relay": "node dist/relay-main.js",
    "reminders:run": "node scripts/run-reminders.mjs",
    "relay:install": "node scripts/local-relay.mjs install",
    "relay:local": "npm run build && node scripts/local-relay.mjs start",
    "relay:stop": "node scripts/local-relay.mjs stop",
    "test": "npm run build && node --import tsx --test test/*.test.mjs",
    "db:generate": "prisma generate",
    "db:check": "npm run build && node scripts/check-database.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "prisma": "6.19.3",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
