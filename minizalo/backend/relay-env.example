# Copy to a private .env.relay on your Vietnam relay host, not on Render.
# This process does not need DATABASE_URL or JWT_SECRET.
ZALO_APP_ID="YOUR_PARENT_ZALO_APP_ID"
ZALO_APP_SECRET="YOUR_PARENT_ZALO_SECRET"
ZALO_RELAY_SECRET="USE_THE_SAME_RANDOM_SECRET_AS_RENDER_AT_LEAST_32_CHARACTERS"
RELAY_PORT=5100
