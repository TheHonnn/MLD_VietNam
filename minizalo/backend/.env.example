# Use the existing shared MLD database, never a separate Mini Zalo database.
DATABASE_URL="postgresql://SHARED_APP_USER:YOUR_PASSWORD@SHARED_HOST:5432/SHARED_DATABASE?schema=public&sslmode=require"
# Private Mini App signing secret. Do not share tokens with native backends.
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# Parent Zalo developer application, NOT the Mini App ID.
ZALO_APP_ID=""
ZALO_APP_SECRET=""
# Enable registration of new shared customers using their Zalo-verified phone.
ZALO_ALLOW_SIGNUP=true
PORT=5000
FRONTEND_ORIGIN="http://localhost:3000"

