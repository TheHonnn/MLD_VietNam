# Use the existing shared MLD database, never a separate Mini Zalo database.
DATABASE_URL="postgresql://SHARED_APP_USER:YOUR_PASSWORD@SHARED_HOST:5432/SHARED_DATABASE?schema=public&sslmode=require"
# Must match the shared backend's HS256 signing secret; JWT sub is users.id (UUID).
JWT_SECRET="REPLACE_WITH_SHARED_JWT_SECRET"
# Optional trusted shared identity relay that returns accessToken/token (shared JWT).
ZALO_AUTH_URL=""
# Server-only Zalo secret for verified phone linking when no relay is configured.
ZALO_APP_SECRET=""
PORT=5000
FRONTEND_ORIGIN="http://localhost:3000"

