// Client generation only. database/schema.sql owns the shared database schema.
// Never use this intentionally partial model for migrations or db push.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @db.Uuid

  @@map("users")
}
