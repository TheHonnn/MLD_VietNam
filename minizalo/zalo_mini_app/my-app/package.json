{
  "name": "my-app",
  "private": true,
  "version": "1.0.0",
  "description": "zmp-blank-templates",
  "repository": "",
  "license": "UNLICENSED",
  "overrides": {
    "zmp-ui": {
      "react-router-dom": "7.18.4"
    },
    "simple-git": "$simple-git",
    "tar": "7.5.22",
    "vite": "$vite",
    "axios": "0.34.0",
    "jsonwebtoken": "9.0.3",
    "ansi-html": "0.0.9",
    "tmp": "0.2.7",
    "micromatch": "4.0.8",
    "braces": "3.0.3",
    "multer": "2.5.0",
    "postcss": "$postcss",
    "serialize-javascript": "7.1.4",
    "svgo": "2.8.4",
    "postcss-svgo": "5.1.0",
    "css-select": "4.3.0",
    "nth-check": "2.1.1",
    "basic-ftp": "6.2.4",
    "browser-sync": "3.0.4",
    "decode-uri-component": "$decode-uri-component"
  },
  "browserslist": [
    "Chrome >= 108",
    "Safari >= 15.4",
    "iOS >= 15.4",
    "Edge >= 108",
    "Firefox >= 109"
  ],
  "scripts": {
    "test:catalog": "node --test scripts/catalog-render.test.mjs",
    "test:staff": "node --test scripts/staff-workspace.test.mjs",
    "test:auth": "node --test scripts/zalo-auth.test.mjs",
    "test:localization": "node --test scripts/localization.test.mjs && node scripts/audit-translations.mjs --check",
    "prebuild": "node scripts/prepare-zmp-toolchain.mjs && node scripts/compile-ui-translations.mjs",
    "build": "vite build",
    "postbuild": "node scripts/check-build-artifacts.mjs",
    "build:verify": "node scripts/check-build-artifacts.mjs",
    "release:check": "node scripts/check-release-config.mjs",
    "backend:check": "node scripts/check-backend.mjs",
    "predeploy:test": "node scripts/prepare-zmp-toolchain.mjs && npm run backend:check",
    "predeploy": "node scripts/prepare-zmp-toolchain.mjs && npm run backend:check",
    "login": "zmp login",
    "start": "zmp start",
    "start:zalo": "zmp start -Z",
    "deploy": "zmp deploy",
    "deploy:test": "zmp deploy --testing --passive --desc \"Mobile testing\" --mode production",
    "postinstall": "node scripts/prepare-zmp-toolchain.mjs",
    "prestart": "node scripts/prepare-zmp-toolchain.mjs",
    "prestart:zalo": "node scripts/prepare-zmp-toolchain.mjs"
  },
  "dependencies": {
    "jotai": "^2.12.1",
    "lucide-react": "^1.62.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zmp-sdk": "2.53.2",
    "zmp-ui": "1.11.14"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "decode-uri-component": "file:./tooling/decode-uri-compat",
    "esbuild": "^0.21.5",
    "postcss": "8.5.32",
    "sass": "^1.76.0",
    "simple-git": "file:./tooling/simple-git-compat",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3",
    "vite": "6.4.5",
    "zmp-cli": "4.0.5",
    "zmp-vite-plugin": "1.1.6"
  }
}
