# ==============================================================================
# MEDICAL HEALTHCARE BACKEND - ENVIRONMENT VARIABLES
# ==============================================================================

PORT=3000
NODE_ENV=development

# SUPABASE CONFIGURATION
# Lấy từ Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT AUTHENTICATION
JWT_SECRET=super-secret-jwt-key-medical-healthcare-2026
JWT_EXPIRES_IN=7d

# REDIS CONFIGURATION (Dùng cho Distributed Lock & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=*

